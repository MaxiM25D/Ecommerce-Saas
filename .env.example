POSTGRES_DB=lunek_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lunek_saas?schema=public"
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
NODE_ENV=development
SESSION_TTL_DAYS=7
SUPERADMIN_EMAIL="superadmin@infinityshop.local"
SUPERADMIN_PASSWORD="cambiar-por-una-clave-segura"
SUPERADMIN_STORE_SLUG="infinityshop-demo"

# Mercado Pago OAuth por tienda. El callback configurado en tu aplicación debe ser:
# http://localhost:4000/api/integrations/mercadopago/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
# Una clave aleatoria de al menos 32 caracteres. No se comparte con el frontend.
MP_TOKEN_ENCRYPTION_KEY=""

SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Cloudinary es opcional. Sin estas variables, desarrollo usa storage/public y storage/private.
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""
PUBLIC_UPLOAD_DIR="storage/public"
PRIVATE_UPLOAD_DIR="storage/private"
RESERVATION_SWEEP_INTERVAL_MS=60000
