NODE_ENV=production
APP_VERSION=git-commit-sha
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
API_PUBLIC_URL=https://api.tudominio.com
WEB_URL=https://app.tudominio.com
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=.tudominio.com
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
TEAM_INVITATION_TTL_DAYS=7

STORAGE_PROVIDER=cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
PUBLIC_UPLOAD_DIR=storage/public
PRIVATE_UPLOAD_DIR=storage/private

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tudominio.com

MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_TOKEN_ENCRYPTION_KEY=

# Facturación de InfinityShop; no usar tokens OAuth de tenants.
SAAS_BILLING_PROVIDER=mercado_pago
SAAS_MP_ACCESS_TOKEN=
SAAS_MP_WEBHOOK_SECRET=

RESERVATION_SWEEP_INTERVAL_MS=60000
