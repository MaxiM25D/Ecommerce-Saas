generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum PlanCode {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

enum StockStatus {
  RESERVED
  COMMITTED
  RELEASED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

enum NotificationStatus {
  NOT_REQUESTED
  PENDING
  SENDING
  SENT
  FAILED
}

model Tenant {
  id                     String                  @id @default(cuid())
  slug                   String                  @unique
  name                   String
  status                 TenantStatus            @default(ACTIVE)
  memberships            Membership[]
  categories             Category[]
  products               Product[]
  customers              Customer[]
  carts                  Cart[]
  orders                 Order[]
  authSessions           AuthSession[]
  settings               StoreSettings?
  subscription           Subscription?
  mercadoPagoConnection  MercadoPagoConnection?
  mercadoPagoOAuthStates MercadoPagoOAuthState[]
  paymentAttempts        PaymentAttempt[]
  paymentReceipts        PaymentReceipt[]
  shipments              Shipment[]
  orderStatusHistory     OrderStatusHistory[]
  teamInvitations        TeamInvitation[]
  lastActiveUsers        User[]                  @relation("UserLastTenant")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  firstName              String
  lastName               String
  platformRole           PlatformRole            @default(USER)
  emailVerifiedAt        DateTime?
  lastTenantId           String?
  lastTenant             Tenant?                 @relation("UserLastTenant", fields: [lastTenantId], references: [id], onDelete: SetNull)
  memberships            Membership[]
  authSessions           AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  sentTeamInvitations    TeamInvitation[]         @relation("TeamInvitationInviter")
  mercadoPagoOAuthStates MercadoPagoOAuthState[]
  orderStatusChanges     OrderStatusHistory[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([lastTenantId])
}

model Plan {
  id                String         @id
  code              PlanCode       @unique
  name              String
  priceInCents      Int
  currency          String         @default("ARS")
  maxProducts       Int
  maxMembers        Int
  maxOrdersPerMonth Int
  active            Boolean        @default(true)
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Subscription {
  tenantId          String             @id
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  trialEndsAt       DateTime?
  currentPeriodFrom DateTime?
  currentPeriodTo   DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([planId, status])
}

model AuthSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeTenantId String
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant   @relation(fields: [activeTenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([activeTenantId, userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TeamInvitation {
  id              String         @id @default(cuid())
  tenantId        String
  email           String
  role            MembershipRole @default(STAFF)
  tokenHash       String         @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, acceptedAt, expiresAt])
  @@index([invitedByUserId])
}

model Membership {
  tenantId  String
  userId    String
  role      MembershipRole @default(STAFF)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([tenantId, userId])
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Product {
  id            String      @id @default(cuid())
  tenantId      String
  categoryId    String?
  sku           String
  slug          String
  name          String
  description   String?
  images        String[]    @default([])
  priceInCents  Int
  stock         Int         @default(0)
  active        Boolean     @default(true)
  brand         String?
  tags          String[]    @default([])
  featured      Boolean     @default(false)
  featuredOrder Int         @default(0)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
}

model StoreSettings {
  tenantId             String   @id
  description          String?
  logoUrl              String?
  bannerUrl            String?
  primaryColor         String   @default("#B89B72")
  contactEmail         String?
  whatsapp             String?
  currency             String   @default("ARS")
  bankName             String?
  bankAlias            String?
  bankHolder           String?
  bankCvu              String?
  bankCuit             String?
  bankTransferEnabled  Boolean  @default(false)
  bankReservationHours Int      @default(24)
  emailFromName        String?
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carts     Cart[]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Cart {
  id         String     @id @default(cuid())
  tenantId   String
  customerId String?
  status     CartStatus @default(ACTIVE)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model CartItem {
  tenantId         String
  cartId           String
  productId        String
  quantity         Int
  unitPriceInCents Int
  cart             Cart     @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  product          Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([tenantId, cartId, productId])
  @@index([tenantId, productId])
}

model Order {
  id              String               @id @default(cuid())
  tenantId        String
  customerId      String?
  number          Int
  status          OrderStatus          @default(PENDING)
  paymentStatus   PaymentStatus        @default(PENDING)
  paymentMethod   PaymentMethod        @default(BANK_TRANSFER)
  stockStatus     StockStatus          @default(RESERVED)
  stockExpiresAt  DateTime?
  publicTokenHash String?              @unique
  customerEmail   String
  customerName    String
  customerPhone   String?
  shippingAddress String?
  notes           String?
  currency        String               @default("ARS")
  subtotalInCents Int
  totalInCents    Int
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items           OrderItem[]
  paymentAttempts PaymentAttempt[]
  paymentReceipt  PaymentReceipt?
  shipment        Shipment?
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, stockStatus, stockExpiresAt])
  @@index([tenantId, customerId])
}

model MercadoPagoConnection {
  tenantId              String    @id
  mercadoPagoUserId     String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime?
  publicKey             String?
  liveMode              Boolean   @default(false)
  webhookKey            String    @unique
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MercadoPagoOAuthState {
  id                    String   @id @default(cuid())
  tenantId              String
  userId                String
  stateHash             String   @unique
  codeVerifierEncrypted String
  expiresAt             DateTime
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([userId])
}

model PaymentAttempt {
  id                 String        @id @default(cuid())
  tenantId           String
  orderId            String
  provider           PaymentMethod
  status             PaymentStatus @default(PENDING)
  idempotencyKey     String        @unique
  preferenceId       String?       @unique
  checkoutUrl        String?
  sandboxCheckoutUrl String?
  externalPaymentId  String?       @unique
  externalStatus     String?
  statusDetail       String?
  amountInCents      Int
  currency           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order              Order         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model PaymentReceipt {
  id              String          @id @default(cuid())
  tenantId        String
  orderId         String          @unique
  storageProvider StorageProvider
  storageKey      String
  originalName    String
  mimeType        String
  sizeInBytes     Int
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId, orderId])
}

model Shipment {
  id                   String             @id @default(cuid())
  tenantId             String
  orderId              String             @unique
  carrier              String
  trackingCode         String?
  trackingUrl          String?
  estimatedDelivery    DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  notificationStatus   NotificationStatus @default(NOT_REQUESTED)
  notificationAttempts Int                @default(0)
  notificationError    String?
  lastNotificationAt   DateTime?
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order                Order              @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId, orderId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  tenantId        String
  orderId         String
  status          OrderStatus
  changedByUserId String?
  note            String?
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order       @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  changedBy       User?       @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  @@index([tenantId, orderId, createdAt])
  @@index([changedByUserId])
}

model OrderItem {
  id               String   @id @default(cuid())
  tenantId         String
  orderId          String
  productId        String?
  sku              String
  productName      String
  quantity         Int
  unitPriceInCents Int
  subtotalInCents  Int
  order            Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product          Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}
