generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum PlanCode {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

model Tenant {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  status       TenantStatus   @default(ACTIVE)
  memberships  Membership[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  carts        Cart[]
  orders       Order[]
  authSessions AuthSession[]
  settings     StoreSettings?
  subscription Subscription?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  platformRole PlatformRole @default(USER)
  memberships  Membership[]
  authSessions AuthSession[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Plan {
  id                String         @id
  code              PlanCode       @unique
  name              String
  priceInCents      Int
  currency          String         @default("ARS")
  maxProducts       Int
  maxMembers        Int
  maxOrdersPerMonth Int
  active            Boolean        @default(true)
  subscriptions     Subscription[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Subscription {
  tenantId          String             @id
  planId            String
  status            SubscriptionStatus @default(TRIALING)
  trialEndsAt       DateTime?
  currentPeriodFrom DateTime?
  currentPeriodTo   DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([planId, status])
}

model AuthSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeTenantId String
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant   @relation(fields: [activeTenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([activeTenantId, userId])
  @@index([expiresAt])
}

model Membership {
  tenantId  String
  userId    String
  role      MembershipRole @default(STAFF)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([tenantId, userId])
  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Product {
  id           String      @id @default(cuid())
  tenantId     String
  categoryId   String?
  sku          String
  slug         String
  name         String
  description  String?
  images       String[]    @default([])
  priceInCents Int
  stock        Int         @default(0)
  active       Boolean     @default(true)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
}

model StoreSettings {
  tenantId     String   @id
  description  String?
  logoUrl      String?
  bannerUrl    String?
  primaryColor String   @default("#B89B72")
  contactEmail String?
  whatsapp     String?
  currency     String   @default("ARS")
  bankName     String?
  bankAlias    String?
  bankHolder   String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  carts     Cart[]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Cart {
  id         String     @id @default(cuid())
  tenantId   String
  customerId String?
  status     CartStatus @default(ACTIVE)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model CartItem {
  tenantId         String
  cartId           String
  productId        String
  quantity         Int
  unitPriceInCents Int
  cart             Cart     @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  product          Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([tenantId, cartId, productId])
  @@index([tenantId, productId])
}

model Order {
  id              String        @id @default(cuid())
  tenantId        String
  customerId      String?
  number          Int
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  customerEmail   String
  customerName    String
  customerPhone   String?
  shippingAddress String?
  notes           String?
  currency        String        @default("ARS")
  subtotalInCents Int
  totalInCents    Int
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model OrderItem {
  id               String   @id @default(cuid())
  tenantId         String
  orderId          String
  productId        String?
  sku              String
  productName      String
  quantity         Int
  unitPriceInCents Int
  subtotalInCents  Int
  order            Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product          Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
}
