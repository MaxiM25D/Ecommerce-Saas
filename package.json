{
  "name": "infinityshop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:up && concurrently --kill-others-on-fail --names WEB,API \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @infinityshop/web",
    "dev:api": "npm run build --workspace @infinityshop/database && npm run dev --workspace @infinityshop/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config packages/database/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:seed": "prisma db seed --config packages/database/prisma.config.ts",
    "db:studio": "prisma studio --config packages/database/prisma.config.ts",
    "db:test:isolation": "npm run test:isolation --workspace @infinityshop/database",
    "db:superadmin": "npm run db:superadmin --workspace @infinityshop/database",
    "test:api": "npm run build --workspace @infinityshop/database && npm run test --workspace @infinityshop/api",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:api && npm run db:test:isolation",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
