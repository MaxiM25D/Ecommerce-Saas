{
  "name": "lunek-saas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @lunek/web",
    "dev:api": "npm run dev --workspace @lunek/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config packages/database/prisma.config.ts",
    "db:seed": "prisma db seed --config packages/database/prisma.config.ts",
    "db:studio": "prisma studio --config packages/database/prisma.config.ts",
    "db:test:isolation": "npm run test:isolation --workspace @lunek/database",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.8.2"
}
